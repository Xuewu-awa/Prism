<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Prism.Desktop.ViewModels"
        x:Class="Prism.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="设置"
        Width="460"
        Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SurfaceBrush}">

    <StackPanel Margin="24" Spacing="16">
        <TextBlock Text="设置"
                   FontSize="18"
                   FontWeight="SemiBold" />

        <Border Classes="card" Padding="18">
            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="应用" FontSize="11" Opacity="0.55" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding VersionText}" FontSize="13" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="替换引擎" FontSize="11" Opacity="0.55" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CliStatus}" FontSize="13" />
                    <TextBlock Text="{Binding AstcencStatus}" FontSize="13" />
                    <TextBlock Text="{Binding TexconvStatus}" FontSize="13" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="临时目录" FontSize="11" Opacity="0.55" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TempDirectory}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="更多设置项将在后续版本加入。"
                   FontSize="11"
                   Opacity="0.5" />
    </StackPanel>
</Window>
